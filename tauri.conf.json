{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauricord",
  "version": "0.6.0",
  "identifier": "io.tauricord.dev",
  "build": {
    "devUrl": "https://discord.com/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/kobayashi90/tauricord/releases/latest/download/updates.json"],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis", "dmg", "appimage"],
    "icon": ["icons/icon.png"],
    "resources": [],
    "windows": {
      "allowDowngrades": false
    },
    "linux": {
      "deb": {
        "desktopTemplate": "assets/io.tauricord.dev.desktop",
        "depends": [],
        "recommends": [
          "gstreamer1.0-plugins-bad",
          "libnice10",
          "libwebrtc-audio-processing1"
        ],
        "postInstallScript": "scripts/postinst.sh"
      }
    }
  }
}
