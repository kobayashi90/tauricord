{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "local": true,
  "remote": {
    "urls": [
      "https://discord.com/*",
      "https://*.discord.com/*"
    ]
  },
  "windows": [
    "main",
    "about"
  ],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "autostart:default",
    "updater:default"
  ]
}
